generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Board {
  id            String   @id @default(cuid())
  title         String
  orgId         String

  imageId       String
  imageThumbUrl String
  imageFullUrl  String
  imageLinkHTML String
  imageUserName String

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}